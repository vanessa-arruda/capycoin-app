# Local database from `make be-db-up`. For Supabase, use the values from its connection settings.
username=postgres
password=postgres
host=localhost
port=5432
dbname=capycoin

# Web app address, used for links in emails.
app_url=http://localhost:5173
# Browser origins allowed to call the API, as a JSON list.
cors_origins=["http://localhost:5173"]
